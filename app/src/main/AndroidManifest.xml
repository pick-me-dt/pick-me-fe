<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 차량 전용 앱 -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 기어(GEAR_SELECTION) -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <!-- 속도(PERF_VEHICLE_SPEED). 런타임 허용이 없으면 속도 없이 기어·주행 규제로 판단한다 -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <!-- NaviHelper 경로 정보 조회(NAVI_ROUTE)·경로 요청(NAVI_ROUTE_SEARCH)·내비 화면 열기(NAVI_CUSTOM_MAP). 모두 normal 권한 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <uses-permission android:name="pleos.car.permission.NAVI_CUSTOM_MAP" />

    <application
        android:name=".app.PickmeApplication"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pickme">

        <!-- 분할 창 크기 변경 시 Activity를 다시 만들지 않고 Compose가 레이아웃을 다시 그린다 -->
        <activity
            android:name=".app.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 주행 중에도 진행 화면을 보여 주기 위한 주행 최적화(DO) 선언. 동작은 게이트 G4에서 확인 -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
    </application>
</manifest>
